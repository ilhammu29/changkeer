# CHANGKEER Environment Variables Reference
# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Dapatkan nilai ini dari Project Settings -> API pada dashboard Supabase Anda.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Service Role Key (SERVER-ONLY - JANGAN PERNAH DI-EXPOSE KE CLIENT BUNDLE)
# Digunakan untuk operasi server terverifikasi dan migrasi backend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# Deployment & Site Config
# ==============================================================================
NEXT_PUBLIC_SITE_URL=https://changkeer.vercel.app
NODE_ENV=production
